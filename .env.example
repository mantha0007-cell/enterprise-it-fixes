# Set this to the final public origin before a production build, for example:
# SITE_URL=https://your-host.example
SITE_URL=

# AdSense stays off unless all four settings are valid. Set CMP_READY only
# after configuring and publishing the appropriate consent message in AdSense.
ADSENSE_ENABLED=false
ADSENSE_CMP_READY=false
ADSENSE_PUBLISHER_ID=
ADSENSE_GUIDE_SLOT=

