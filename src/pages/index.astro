---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import CaseCard from '../components/CaseCard.astro';
const allCases = await getCollection('cases', ({ data }) => data.visibility === 'published');
const recent = [...allCases].sort((a,b) => b.data.dateModified.valueOf() - a.data.dateModified.valueOf()).slice(0,6);
const products = [...new Set(allCases.map(({data}) => data.product))].sort();
const categories = [...new Set(allCases.map(({data}) => data.category))].sort();
const vendors = [...new Set(allCases.map(({data}) => data.vendor))].sort();
---
<SiteLayout description="Practical enterprise IT troubleshooting guides for exact errors, event IDs, log lines, products, and symptoms, with links to vendor sources.">
  <div class="page">
    <section class="hero">
      <p class="eyebrow">Enterprise troubleshooting notes</p>
      <h1>Practical guidance for<br />complex IT problems.</h1>
      <p class="lead">Search exact errors, event IDs, log lines, and product combinations. Find practical troubleshooting steps and source links to help investigate similar IT problems.</p>
      <form class="search-form" action="/search/" method="get" role="search"><label class="sr-only" for="home-search">Search troubleshooting guides</label><input id="home-search" type="search" name="q" placeholder="Search an error, event ID, product, or symptom…" /><button type="submit">Search guides</button></form>
      <p class="search-hint">Search guide titles, symptoms, products, vendors, versions, tags, error codes, event IDs, and log files.</p>
    </section>
    <section class="section">
      <div class="section-heading"><h2>Recently updated troubleshooting guides</h2><a href="/browse/">Browse all →</a></div>
      {recent.length ? <div class="case-grid">{recent.map((entry) => <CaseCard entry={entry} />)}</div> : <p class="empty-state">The first troubleshooting guide will appear here.</p>}
    </section>
    <section class="section"><div class="section-heading"><h2>Start with an exact error or event</h2></div><div class="facet-list">{allCases.map((entry) => <a class="facet-chip" href={`/cases/${entry.data.slug}/`}>{entry.data.errorCodes[0] || entry.data.eventIds[0] || entry.data.symptoms[0]}</a>)}</div></section>
    <section class="section split">
      <div class="info-panel"><div class="section-heading"><h2>Browse by product</h2><a href="/browse/">All topics →</a></div><div class="facet-list">{products.map((name) => <a class="facet-chip" href={`/browse/products/${encodeURIComponent(name.toLowerCase().replaceAll(' ','-'))}/`}>{name}</a>)}</div></div>
      <div class="info-panel"><h2>Browse by category</h2><div class="facet-list">{categories.map((name) => <a class="facet-chip" href={`/browse/categories/${encodeURIComponent(name.toLowerCase().replaceAll(' ','-'))}/`}>{name}</a>)}</div><h2 style="margin-top:24px">Vendors</h2><div class="facet-list">{vendors.map((name) => <a class="facet-chip" href={`/browse/vendors/${encodeURIComponent(name.toLowerCase().replaceAll(' ','-'))}/`}>{name}</a>)}</div></div>
    </section>
    <aside class="notice"><strong>Use your own context.</strong> Troubleshooting guidance can help narrow down similar symptoms, but the cause and right change depend on your environment. Check the linked vendor sources and your change-control process.</aside>
  </div>
</SiteLayout>
<style>.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style>
