---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { facets, slugify } from '../../lib/cases';
const entries = await getCollection('cases', ({data}) => data.visibility === 'published');
const groups = facets(entries);
const sorted = [...entries].sort((a,b) => b.data.dateModified.valueOf() - a.data.dateModified.valueOf());
---
<SiteLayout title="Browse troubleshooting guides | Enterprise IT Fixes" description="Browse practical enterprise IT troubleshooting guides by product, vendor, category, and tag.">
  <div class="page"><p class="eyebrow">Guide library</p><h1 class="page-title">Browse troubleshooting guides</h1><p class="page-lead">Find a guide by the product, vendor, category, or tag that matches your environment.</p>
    <section class="section"><div class="section-heading"><h2>Products</h2></div><div class="facet-list">{groups.products.map((value) => <a class="facet-chip" href={`/browse/products/${slugify(value)}/`}>{value}</a>)}</div></section>
    <section class="section"><div class="section-heading"><h2>Vendors</h2></div><div class="facet-list">{groups.vendors.map((value) => <a class="facet-chip" href={`/browse/vendors/${slugify(value)}/`}>{value}</a>)}</div></section>
    <section class="section"><div class="section-heading"><h2>Categories</h2></div><div class="facet-list">{groups.categories.map((value) => <a class="facet-chip" href={`/browse/categories/${slugify(value)}/`}>{value}</a>)}</div></section>
    <section class="section"><div class="section-heading"><h2>Tags</h2></div><div class="facet-list">{groups.tags.map((value) => <a class="facet-chip" href={`/browse/tags/${slugify(value)}/`}>{value}</a>)}</div></section>
    <section class="section"><div class="section-heading"><h2>All guides ({sorted.length})</h2></div>{sorted.length ? <div class="case-grid">{sorted.map((entry) => <CaseCard entry={entry} />)}</div> : <p class="empty-state">No guides have been published yet.</p>}</section>
  </div>
</SiteLayout>
