---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import CaseCard from '../../../components/CaseCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { facets, slugify } from '../../../lib/cases';
const titles: Record<string,string> = { categories:'Category', products:'Product', vendors:'Vendor', tags:'Tag' };
export async function getStaticPaths() {
const entries = await getCollection('cases', ({data}) => data.visibility === 'published');
  const f = facets(entries);
  return Object.entries(f).flatMap(([facet, values]) => {
    // Distinct labels can normalize to the same URL slug (for example, case
    // variants). Emit one route per slug; tag matches below include all variants.
    const namesBySlug = new Map<string, string>();
    for (const name of values) {
      const slug = slugify(name);
      if (!namesBySlug.has(slug)) namesBySlug.set(slug, name);
    }
    return [...namesBySlug].map(([slug, name]) => {
      const selected = entries.filter(({data}) => facet === 'categories' ? slugify(data.category) === slug : facet === 'products' ? slugify(data.product) === slug : facet === 'vendors' ? slugify(data.vendor) === slug : data.tags.some((tag) => slugify(tag) === slug));
      return { params: { facet, slug }, props: { name, facet, entries: selected } };
    });
  });
}
const { name, facet, entries } = Astro.props;
const sorted = [...entries].sort((a,b) => b.data.dateModified.valueOf() - a.data.dateModified.valueOf());
const title = `${name} troubleshooting guides | Enterprise IT Fixes`;
---
<SiteLayout title={title} description={`Enterprise IT troubleshooting guides tagged ${name}.`} noindex structuredData={{'@context':'https://schema.org','@type':'CollectionPage',name,description:`Enterprise IT troubleshooting guides for ${name}.`,...(Astro.site?{url:new URL(Astro.url.pathname,Astro.site).toString()}:{})}}>
  <div class="page"><Breadcrumbs items={[{label:'Browse',href:'/browse/'},{label:titles[facet],href:'/browse/'},{label:name}]} /><p class="eyebrow">{titles[facet]}</p><h1 class="page-title">{name}</h1><p class="page-lead">Troubleshooting guides associated with {name}.</p>
    {sorted.length ? <div class="case-grid section">{sorted.map((entry) => <CaseCard entry={entry} />)}</div> : <p class="empty-state section">No guides are listed here yet.</p>}
  </div>
</SiteLayout>
