---
import SiteLayout from '../../layouts/SiteLayout.astro';
const q = Astro.url.searchParams.get('q') || '';
---
<SiteLayout title="Search troubleshooting guides | Enterprise IT Fixes" description="Search enterprise IT troubleshooting guides by exact errors, products, event IDs, and symptoms." noindex>
  <div class="page"><p class="eyebrow">Case search</p><h1 class="page-title">Search troubleshooting guides</h1><p class="page-lead">Search exact errors, event IDs, products, versions, symptoms, and log files.</p>
    <form class="search-form" action="/search/" method="get" role="search" data-search-form><label class="sr-only" for="case-search">Search troubleshooting guides</label><input id="case-search" type="search" name="q" value={q} placeholder="Try an error code or exact log line…" data-search-input /><button type="submit">Search guides</button></form>
    <p class="search-status" data-search-status aria-live="polite">{q ? 'Preparing search…' : 'Enter an error, product, log file, or symptom to search troubleshooting guides.'}</p><div class="search-results" data-search-results></div>
    <noscript><p class="notice">Enable JavaScript to use the local guide search. Browse guides without JavaScript on the <a href="/browse/">browse page</a>.</p></noscript>
  </div><script is:inline src="/search.js"></script>
</SiteLayout>
<style>.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style>
