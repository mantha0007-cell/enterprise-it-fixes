---
const publisherId = import.meta.env.ADSENSE_PUBLISHER_ID?.trim() ?? '';
const slotId = import.meta.env.ADSENSE_GUIDE_SLOT?.trim() ?? '';
const enabled = import.meta.env.ADSENSE_ENABLED === 'true';
const consentReady = import.meta.env.ADSENSE_CMP_READY === 'true';
const validPublisherId = /^ca-pub-\d{16}$/.test(publisherId);
const validSlotId = /^\d+$/.test(slotId);
const active = enabled && consentReady && validPublisherId && validSlotId;
---
{active && <aside class="ad-slot" aria-label="Advertisement">
  <p class="ad-label">Advertisement</p>
  <ins class="adsbygoogle"
    style="display:block"
    data-ad-client={publisherId}
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${publisherId}`} crossorigin="anonymous"></script>
  <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
</aside>}

<style>
  .ad-slot{margin:28px 0 4px;padding:14px 0;border-top:1px solid #dce3e8;text-align:center;min-height:110px}
  .ad-label{margin:0 0 8px;color:#687781;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}
</style>
