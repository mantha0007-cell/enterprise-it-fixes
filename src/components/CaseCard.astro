---
const { entry } = Astro.props;
---
<a class="case-card" href={`/cases/${entry.data.slug}/`}>
  <h3>{entry.data.title}</h3>
  <p>{entry.data.description}</p>
  <span class="card-meta">{entry.data.vendor} · {entry.data.product} · Updated {entry.data.dateModified.toISOString().slice(0, 10)}</span>
</a>
