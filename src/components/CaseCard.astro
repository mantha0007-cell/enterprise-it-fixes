---
const { entry } = Astro.props;
const { status, verified } = entry.data;
const badge = status === 'verified' && verified ? 'FIELD-VERIFIED FIX' : status === 'documented' ? 'DOCUMENTED GUIDE · NOT FIELD-TESTED' : 'DEMO · NOT VERIFIED';
const badgeClass = status === 'verified' && verified ? '' : status === 'documented' ? 'badge-documented' : 'badge-demo';
---
<a class="case-card" href={`/cases/${entry.data.slug}/`}>
  <span class:list={['badge', badgeClass]}>{badge}</span>
  <h3>{entry.data.title}</h3>
  <p>{entry.data.description}</p>
  <span class="card-meta">{entry.data.vendor} · {entry.data.product} · Updated {entry.data.dateModified.toISOString().slice(0, 10)}</span>
</a>
